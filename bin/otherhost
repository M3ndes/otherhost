#!/usr/bin/env bash
set -u

SCRIPT_PATH=$0
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR=$(CDPATH='' cd -P -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
  LINK_TARGET=$(readlink "$SCRIPT_PATH")
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH=$LINK_TARGET ;;
    *) SCRIPT_PATH="$SCRIPT_DIR/$LINK_TARGET" ;;
  esac
done
ROOT_DIR=$(CDPATH='' cd -P -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd)
# shellcheck source=../lib/otherhost.sh
. "$ROOT_DIR/lib/otherhost.sh"

if [ -n "${OTHERHOST_CONFIG:-}" ]; then
  CONFIG_FILE=$OTHERHOST_CONFIG
elif [ -n "${DEVBOX_CONFIG:-}" ]; then
  CONFIG_FILE=$DEVBOX_CONFIG
elif [ -f "$ROOT_DIR/otherhost.local.conf" ]; then
  CONFIG_FILE="$ROOT_DIR/otherhost.local.conf"
elif [ -f "$ROOT_DIR/devbox.local.conf" ]; then
  CONFIG_FILE="$ROOT_DIR/devbox.local.conf"
else
  CONFIG_FILE="$ROOT_DIR/otherhost.local.conf"
fi
COMMAND=doctor
SSH_CONFIG_APPLY=0
PAIR_COMPLETED=0
PAIRING_VERSION=v0.1.1
PAIRING_DISCOVERY_ADDRESS=239.255.67.89:25370
PAIRING_PORT=25371

usage() {
  cat <<'EOF'
◉  otherhost
   Make the other host feel local.

Usage: otherhost [--config PATH] COMMAND

Commands:
  pair        Discover and securely pair with a Windows otherhost.
  doctor      Validate local dependencies, configuration, and connectivity.
  connect     Open SSH port forwards and keep the session in the foreground.
  ssh-config  Print an OpenSSH host block, or install it with --apply.
  status      Show remote host, memory, disk, and Docker status over SSH.
  urls        Print the forwarded localhost URLs.
  ui          Open the project dashboard in the local browser.
  help        Show this help.

Environment:
  OTHERHOST_CONFIG  Default configuration path.
  OTHERHOST_UI_BIN  Dashboard binary override for local development.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --config)
      [ "$#" -ge 2 ] || { printf '%s\n' '--config requires a path' >&2; exit 2; }
      CONFIG_FILE=$2
      shift 2
      ;;
    -h|--help|help)
      COMMAND=help
      shift
      ;;
    pair|doctor|connect|ssh-config|status|urls|ui)
      COMMAND=$1
      shift
      ;;
    --apply)
      SSH_CONFIG_APPLY=1
      shift
      ;;
    *)
      printf 'Unknown argument: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [ "$SSH_CONFIG_APPLY" -eq 1 ] && [ "$COMMAND" != ssh-config ]; then
  printf '%s\n' '--apply is supported only with ssh-config' >&2
  exit 2
fi

[ "$COMMAND" = help ] && { usage; exit 0; }

run_pair() {
  case "$(uname -s)" in
    Darwin) ;;
    *) printf '%s\n' '[fail] otherhost pair currently supports macOS clients only' >&2; exit 1 ;;
  esac

  if [ ! -f "$CONFIG_FILE" ]; then
    mkdir -p "$(dirname -- "$CONFIG_FILE")"
    cp "$ROOT_DIR/config/otherhost.example.conf" "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
    printf '[ok] created local configuration: %s\n' "$CONFIG_FILE"
  fi

  identity_config=$(otherhost_config_get identity_file "$CONFIG_FILE")
  [ -n "$identity_config" ] || identity_config=.ssh/otherhost_ed25519
  identity_file=$(otherhost_resolve_identity_file "$identity_config")
  if [ ! -f "$identity_file" ]; then
    mkdir -p "$(dirname -- "$identity_file")"
    chmod 700 "$(dirname -- "$identity_file")"
    ssh-keygen -q -t ed25519 -a 64 -N '' -f "$identity_file" -C 'otherhost client'
    chmod 600 "$identity_file"
    printf '[ok] created dedicated SSH identity: %s\n' "$identity_file"
  fi
  if [ ! -f "$identity_file.pub" ]; then
    ssh-keygen -y -f "$identity_file" > "$identity_file.pub"
    chmod 644 "$identity_file.pub"
  fi

  known_hosts_config=$(otherhost_config_get known_hosts_file "$CONFIG_FILE")
  [ -n "$known_hosts_config" ] || known_hosts_config=.ssh/otherhost_known_hosts
  known_hosts_file=$(otherhost_resolve_identity_file "$known_hosts_config")

  pairing_bin_override=${OTHERHOST_PAIR_BIN:-${DEVBOX_PAIR_BIN:-}}
  if [ -n "$pairing_bin_override" ]; then
    pairing_helper=$pairing_bin_override
    [ -x "$pairing_helper" ] || { printf '[fail] OTHERHOST_PAIR_BIN is not executable: %s\n' "$pairing_helper" >&2; exit 1; }
  else
    pairing_helper="$HOME/.local/lib/otherhost/otherhost-pair"
    legacy_pairing_helper="$HOME/.local/lib/devbox-bridge/devbox-pair"
    installed_pairing_version=''
    if [ -x "$pairing_helper" ]; then
      installed_pairing_version=$("$pairing_helper" version 2>/dev/null | awk 'NR == 1 { print $2 }')
    fi
    if [ "$installed_pairing_version" != "$PAIRING_VERSION" ] && [ -x "$legacy_pairing_helper" ]; then
      legacy_pairing_version=$("$legacy_pairing_helper" version 2>/dev/null | awk 'NR == 1 { print $2 }')
      if [ "$legacy_pairing_version" = "$PAIRING_VERSION" ]; then
        pairing_helper=$legacy_pairing_helper
        installed_pairing_version=$legacy_pairing_version
      fi
    fi
    if [ "$installed_pairing_version" != "$PAIRING_VERSION" ]; then
      "$ROOT_DIR/scripts/install-pairing-helper.sh" "$pairing_helper"
    fi
  fi

  if ! "$pairing_helper" pair \
    --config "$CONFIG_FILE" \
    --public-key "$identity_file.pub" \
    --known-hosts "$known_hosts_file" \
    --pair-port "$PAIRING_PORT" \
    --discovery-address "$PAIRING_DISCOVERY_ADDRESS"; then
    printf '%s\n' '[fail] pairing stopped before the local connection was updated' >&2
    return 1
  fi
  printf '\nVerifying the new connection...\n'
}

if [ "$COMMAND" = pair ]; then
  run_pair || exit $?
  PAIR_COMPLETED=1
  COMMAND=doctor
fi

otherhost_require_config "$CONFIG_FILE" || exit 1

NAME=$(otherhost_config_get otherhost_name "$CONFIG_FILE")
[ -n "$NAME" ] || NAME=$(otherhost_config_get devbox_name "$CONFIG_FILE")
HOST=$(otherhost_config_get host "$CONFIG_FILE")
SSH_USER=$(otherhost_config_get ssh_user "$CONFIG_FILE")
SSH_PORT=$(otherhost_config_get ssh_port "$CONFIG_FILE")
PORTS=$(otherhost_config_get ports "$CONFIG_FILE")
IDENTITY_CONFIG=$(otherhost_config_get identity_file "$CONFIG_FILE")
IDENTITY_FILE=$(otherhost_resolve_identity_file "$IDENTITY_CONFIG")
KNOWN_HOSTS_CONFIG=$(otherhost_config_get known_hosts_file "$CONFIG_FILE")
KNOWN_HOSTS_FILE=''
if [ -n "$KNOWN_HOSTS_CONFIG" ]; then
  KNOWN_HOSTS_FILE=$(otherhost_resolve_identity_file "$KNOWN_HOSTS_CONFIG")
fi

FAILURES=0

ok() { printf '[ok] %s\n' "$*"; }
warn() { printf '[warn] %s\n' "$*"; }
fail() { printf '[fail] %s\n' "$*" >&2; FAILURES=$((FAILURES + 1)); }

validate_config() {
  [ -n "$NAME" ] || fail 'otherhost_name is required'
  case "$NAME" in *[!A-Za-z0-9._-]*) fail 'otherhost_name contains unsupported characters' ;; esac
  [ -n "$HOST" ] || fail 'host is required'
  [ "$HOST" != CHANGE_ME ] || fail 'host still uses CHANGE_ME'
  case "$HOST" in *[!A-Za-z0-9._:-]*) fail 'host contains unsupported characters' ;; esac

  [ -n "$SSH_USER" ] || fail 'ssh_user is required'
  case "$SSH_USER" in *[!A-Za-z0-9._-]*) fail 'ssh_user contains unsupported characters' ;; esac

  if ! otherhost_is_positive_integer "$SSH_PORT" || [ "$SSH_PORT" -gt 65535 ]; then
    fail 'ssh_port must be between 1 and 65535'
  fi

  if [ -z "$PORTS" ]; then
    fail 'ports must contain at least one port'
  else
    old_ifs=$IFS
    IFS=,
    for port in $PORTS; do
      port=$(otherhost_trim "$port")
      if ! otherhost_is_positive_integer "$port" || [ "$port" -gt 65535 ]; then
        fail "invalid forwarded port: $port"
      fi
    done
    IFS=$old_ifs
  fi

  [ -n "$IDENTITY_CONFIG" ] || fail 'identity_file is required'
  case "$IDENTITY_CONFIG" in *\"*) fail 'identity_file cannot contain a double quote' ;; esac
  case "$KNOWN_HOSTS_CONFIG" in *\"*) fail 'known_hosts_file cannot contain a double quote' ;; esac
}

build_ssh_args() {
  SSH_ARGS=(
    -p "$SSH_PORT"
    -i "$IDENTITY_FILE"
    -o IdentitiesOnly=yes
    -o ConnectTimeout=5
    -o ServerAliveInterval=30
    -o ServerAliveCountMax=3
  )
  if [ -n "$KNOWN_HOSTS_FILE" ]; then
    SSH_ARGS+=(
      -o "UserKnownHostsFile=$KNOWN_HOSTS_FILE"
      -o StrictHostKeyChecking=yes
    )
  fi
}

run_doctor() {
  printf 'Otherhost: %s\nConfig: %s\n\n' "$NAME" "$CONFIG_FILE"
  validate_config

  for command_name in ssh git awk sed; do
    if command -v "$command_name" >/dev/null 2>&1; then
      ok "$command_name is available"
    else
      fail "$command_name is not installed"
    fi
  done

  case "$(uname -s)" in
    Darwin) ok 'macOS client detected' ;;
    Linux)
      if grep -qi microsoft /proc/version 2>/dev/null; then
        ok 'WSL environment detected'
      else
        warn 'generic Linux environment detected'
      fi
      ;;
    *) warn "untested operating system: $(uname -s)" ;;
  esac

  if [ -f "$IDENTITY_FILE" ]; then
    permissions=$(stat -f '%Lp' "$IDENTITY_FILE" 2>/dev/null || stat -c '%a' "$IDENTITY_FILE" 2>/dev/null || true)
    case "$permissions" in
      600|400) ok "SSH identity exists with safe permissions: $IDENTITY_FILE" ;;
      '') warn "could not inspect identity permissions: $IDENTITY_FILE" ;;
      *) warn "SSH identity permissions are $permissions; expected 600 or 400" ;;
    esac
  else
    fail "SSH identity does not exist: $IDENTITY_FILE"
  fi

  if [ -n "$KNOWN_HOSTS_FILE" ]; then
    if [ -f "$KNOWN_HOSTS_FILE" ]; then
      ok "pinned SSH host identity exists: $KNOWN_HOSTS_FILE"
    else
      fail "pinned SSH host identity does not exist: $KNOWN_HOSTS_FILE"
    fi
  else
    warn 'known_hosts_file is not configured; pair again to pin the SSH host identity'
  fi

  if [ "$FAILURES" -eq 0 ]; then
    build_ssh_args
    if ssh "${SSH_ARGS[@]}" -o BatchMode=yes "$SSH_USER@$HOST" 'exit 0' >/dev/null 2>&1; then
      ok "SSH connection succeeded: $SSH_USER@$HOST:$SSH_PORT"
    else
      fail "SSH connection failed: $SSH_USER@$HOST:$SSH_PORT"
    fi
  fi

  [ "$FAILURES" -eq 0 ]
}

run_connect() {
  validate_config
  [ "$FAILURES" -eq 0 ] || exit 1

  build_ssh_args
  old_ifs=$IFS
  IFS=,
  for port in $PORTS; do
    port=$(otherhost_trim "$port")
    SSH_ARGS+=( -L "127.0.0.1:$port:127.0.0.1:$port" )
  done
  IFS=$old_ifs

  printf 'Opening forwards for ports %s. Press Ctrl-C to disconnect.\n' "$PORTS"
  exec ssh "${SSH_ARGS[@]}" -o ExitOnForwardFailure=yes -N "$SSH_USER@$HOST"
}

write_ssh_config_block() {
  printf 'Host %s\n' "$NAME"
  printf '    HostName %s\n' "$HOST"
  printf '    User %s\n' "$SSH_USER"
  printf '    Port %s\n' "$SSH_PORT"
  printf '    IdentityFile "%s"\n' "$IDENTITY_FILE"
  if [ -n "$KNOWN_HOSTS_FILE" ]; then
    printf '    UserKnownHostsFile "%s"\n' "$KNOWN_HOSTS_FILE"
    printf '    StrictHostKeyChecking yes\n'
  fi
  printf '    IdentitiesOnly yes\n'
  printf '    ServerAliveInterval 30\n'
  printf '    ServerAliveCountMax 3\n'
  printf '    ExitOnForwardFailure yes\n'
  old_ifs=$IFS
  IFS=,
  for port in $PORTS; do
    port=$(otherhost_trim "$port")
    printf '    LocalForward 127.0.0.1:%s 127.0.0.1:%s\n' "$port" "$port"
  done
  IFS=$old_ifs
}

install_ssh_config() {
  validate_config
  [ "$FAILURES" -eq 0 ] || return 1

  ssh_directory=$HOME/.ssh
  ssh_config_path=$ssh_directory/config
  start_marker="# BEGIN otherhost: $NAME"
  end_marker="# END otherhost: $NAME"

  mkdir -p "$ssh_directory"
  chmod 700 "$ssh_directory"

  if [ -f "$ssh_config_path" ]; then
    start_count=$(grep -Fxc "$start_marker" "$ssh_config_path" || true)
    end_count=$(grep -Fxc "$end_marker" "$ssh_config_path" || true)
    if [ "$start_count" -gt 1 ] || [ "$start_count" -ne "$end_count" ]; then
      printf '[fail] managed SSH block markers are inconsistent in %s\n' "$ssh_config_path" >&2
      return 1
    fi
  fi

  temporary_config=$(mktemp "$ssh_config_path.tmp.XXXXXX") || return 1
  if ! {
    printf '%s\n' "$start_marker"
    write_ssh_config_block
    printf '%s\n' "$end_marker"
    if [ -s "$ssh_config_path" ]; then
      printf '\n'
      awk -v start="$start_marker" -v end="$end_marker" '
        $0 == start { skipping = 1; next }
        skipping && $0 == end { skipping = 0; drop_blank = 1; next }
        drop_blank && $0 == "" { drop_blank = 0; next }
        { drop_blank = 0 }
        !skipping { print }
      ' "$ssh_config_path"
    fi
  } > "$temporary_config"; then
    rm -f "$temporary_config"
    return 1
  fi
  chmod 600 "$temporary_config"
  mv "$temporary_config" "$ssh_config_path"
  printf '[ok] installed managed SSH host %s in %s\n' "$NAME" "$ssh_config_path"
}

ssh_alias_matches_config() {
  command -v ssh >/dev/null 2>&1 || return 1
  resolved_config=$(ssh -G -- "$NAME" 2>/dev/null) || return 1
  resolved_host=$(printf '%s\n' "$resolved_config" | awk '$1 == "hostname" { print $2; exit }')
  resolved_user=$(printf '%s\n' "$resolved_config" | awk '$1 == "user" { print $2; exit }')
  resolved_port=$(printf '%s\n' "$resolved_config" | awk '$1 == "port" { print $2; exit }')
  resolved_identity=$(printf '%s\n' "$resolved_config" | awk '$1 == "identityfile" { $1 = ""; sub(/^ /, ""); print; exit }')
  [ "$resolved_host" = "$HOST" ] &&
    [ "$resolved_user" = "$SSH_USER" ] &&
    [ "$resolved_port" = "$SSH_PORT" ] &&
    [ "$resolved_identity" = "$IDENTITY_FILE" ]
}

offer_ssh_config_after_pairing() {
  if ssh_alias_matches_config; then
    ok "VS Code SSH alias is ready: $NAME"
    return
  fi
  printf '\nVS Code Remote SSH needs a managed OpenSSH host entry.\n'
  if [ -t 0 ]; then
    printf 'Install it in ~/.ssh/config now? [Y/n] '
    IFS= read -r answer || answer=''
    case "$answer" in
      n|N|no|NO) warn 'run otherhost ssh-config --apply before opening a project in VS Code' ;;
      *) install_ssh_config ;;
    esac
  else
    warn 'run otherhost ssh-config --apply before opening a project in VS Code'
  fi
}

run_ssh_config() {
  if [ "$SSH_CONFIG_APPLY" -eq 1 ]; then
    install_ssh_config
  else
    validate_config
    [ "$FAILURES" -eq 0 ] || return 1
    write_ssh_config_block
  fi
}

run_status() {
  validate_config
  [ "$FAILURES" -eq 0 ] || exit 1
  build_ssh_args
  ssh "${SSH_ARGS[@]}" "$SSH_USER@$HOST" '
    printf "HOST\n"; hostname; uptime
    printf "\nMEMORY\n"; free -h
    printf "\nDISK\n"; df -h /
    printf "\nDOCKER\n"
    if command -v docker >/dev/null 2>&1; then
      docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Image}}"
      docker system df
    else
      echo "docker is not available"
    fi
  '
}

run_urls() {
  validate_config
  [ "$FAILURES" -eq 0 ] || exit 1
  old_ifs=$IFS
  IFS=,
  for port in $PORTS; do
    port=$(otherhost_trim "$port")
    printf 'http://localhost:%s\n' "$port"
  done
  IFS=$old_ifs
}

run_ui() {
  ui_bin_override=${OTHERHOST_UI_BIN:-${DEVBOX_UI_BIN:-}}
  if [ -n "$ui_bin_override" ]; then
    [ -x "$ui_bin_override" ] || { printf '[fail] OTHERHOST_UI_BIN is not executable: %s\n' "$ui_bin_override" >&2; exit 1; }
    exec "$ui_bin_override" --config "$CONFIG_FILE"
  fi
  if [ -x "$ROOT_DIR/build/otherhost-ui" ]; then
    exec "$ROOT_DIR/build/otherhost-ui" --config "$CONFIG_FILE"
  fi
  if command -v go >/dev/null 2>&1; then
    cd "$ROOT_DIR" || exit 1
    exec go run ./cmd/otherhost-ui --config "$CONFIG_FILE"
  fi
  printf '%s\n' '[fail] the dashboard preview requires Go 1.22+ or a local build from make build-ui' >&2
  exit 1
}

case "$COMMAND" in
  doctor)
    if run_doctor; then
      if [ "$PAIR_COMPLETED" -eq 1 ]; then
        offer_ssh_config_after_pairing
      fi
    else
      exit 1
    fi
    ;;
  connect) run_connect ;;
  ssh-config) run_ssh_config ;;
  status) run_status ;;
  urls) run_urls ;;
  ui) run_ui ;;
esac
