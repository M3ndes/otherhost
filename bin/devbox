#!/usr/bin/env bash
set -u

ROOT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
# shellcheck source=../lib/devbox.sh
. "$ROOT_DIR/lib/devbox.sh"

CONFIG_FILE=${DEVBOX_CONFIG:-"$ROOT_DIR/devbox.local.conf"}
COMMAND=doctor

usage() {
  cat <<'EOF'
Usage: devbox [--config PATH] COMMAND

Commands:
  doctor      Validate local dependencies, configuration, and connectivity.
  connect     Open SSH port forwards and keep the session in the foreground.
  ssh-config  Print an OpenSSH config block for this devbox.
  status      Show remote host, memory, disk, and Docker status over SSH.
  urls        Print the forwarded localhost URLs.
  help        Show this help.

Environment:
  DEVBOX_CONFIG  Default configuration path.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --config)
      [ "$#" -ge 2 ] || { printf '%s\n' '--config requires a path' >&2; exit 2; }
      CONFIG_FILE=$2
      shift 2
      ;;
    -h|--help|help)
      COMMAND=help
      shift
      ;;
    doctor|connect|ssh-config|status|urls)
      COMMAND=$1
      shift
      ;;
    *)
      printf 'Unknown argument: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

[ "$COMMAND" = help ] && { usage; exit 0; }
devbox_require_config "$CONFIG_FILE" || exit 1

NAME=$(devbox_config_get devbox_name "$CONFIG_FILE")
HOST=$(devbox_config_get host "$CONFIG_FILE")
SSH_USER=$(devbox_config_get ssh_user "$CONFIG_FILE")
SSH_PORT=$(devbox_config_get ssh_port "$CONFIG_FILE")
PORTS=$(devbox_config_get ports "$CONFIG_FILE")
IDENTITY_CONFIG=$(devbox_config_get identity_file "$CONFIG_FILE")
IDENTITY_FILE=$(devbox_resolve_identity_file "$IDENTITY_CONFIG")

FAILURES=0

ok() { printf '[ok] %s\n' "$*"; }
warn() { printf '[warn] %s\n' "$*"; }
fail() { printf '[fail] %s\n' "$*" >&2; FAILURES=$((FAILURES + 1)); }

validate_config() {
  [ -n "$NAME" ] || fail 'devbox_name is required'
  case "$NAME" in *[!A-Za-z0-9._-]*) fail 'devbox_name contains unsupported characters' ;; esac
  [ -n "$HOST" ] || fail 'host is required'
  [ "$HOST" != CHANGE_ME ] || fail 'host still uses CHANGE_ME'
  case "$HOST" in *[!A-Za-z0-9._:-]*) fail 'host contains unsupported characters' ;; esac

  [ -n "$SSH_USER" ] || fail 'ssh_user is required'
  case "$SSH_USER" in *[!A-Za-z0-9._-]*) fail 'ssh_user contains unsupported characters' ;; esac

  if ! devbox_is_positive_integer "$SSH_PORT" || [ "$SSH_PORT" -gt 65535 ]; then
    fail 'ssh_port must be between 1 and 65535'
  fi

  if [ -z "$PORTS" ]; then
    fail 'ports must contain at least one port'
  else
    old_ifs=$IFS
    IFS=,
    for port in $PORTS; do
      port=$(devbox_trim "$port")
      if ! devbox_is_positive_integer "$port" || [ "$port" -gt 65535 ]; then
        fail "invalid forwarded port: $port"
      fi
    done
    IFS=$old_ifs
  fi

  [ -n "$IDENTITY_CONFIG" ] || fail 'identity_file is required'
  case "$IDENTITY_CONFIG" in *\"*) fail 'identity_file cannot contain a double quote' ;; esac
}

build_ssh_args() {
  SSH_ARGS=(
    -p "$SSH_PORT"
    -i "$IDENTITY_FILE"
    -o IdentitiesOnly=yes
    -o ConnectTimeout=5
    -o ServerAliveInterval=30
    -o ServerAliveCountMax=3
  )
}

run_doctor() {
  printf 'Devbox: %s\nConfig: %s\n\n' "$NAME" "$CONFIG_FILE"
  validate_config

  for command_name in ssh git awk sed; do
    if command -v "$command_name" >/dev/null 2>&1; then
      ok "$command_name is available"
    else
      fail "$command_name is not installed"
    fi
  done

  case "$(uname -s)" in
    Darwin) ok 'macOS client detected' ;;
    Linux)
      if grep -qi microsoft /proc/version 2>/dev/null; then
        ok 'WSL environment detected'
      else
        warn 'generic Linux environment detected'
      fi
      ;;
    *) warn "untested operating system: $(uname -s)" ;;
  esac

  if [ -f "$IDENTITY_FILE" ]; then
    permissions=$(stat -f '%Lp' "$IDENTITY_FILE" 2>/dev/null || stat -c '%a' "$IDENTITY_FILE" 2>/dev/null || true)
    case "$permissions" in
      600|400) ok "SSH identity exists with safe permissions: $IDENTITY_FILE" ;;
      '') warn "could not inspect identity permissions: $IDENTITY_FILE" ;;
      *) warn "SSH identity permissions are $permissions; expected 600 or 400" ;;
    esac
  else
    fail "SSH identity does not exist: $IDENTITY_FILE"
  fi

  if [ "$FAILURES" -eq 0 ]; then
    build_ssh_args
    if ssh "${SSH_ARGS[@]}" -o BatchMode=yes "$SSH_USER@$HOST" 'exit 0' >/dev/null 2>&1; then
      ok "SSH connection succeeded: $SSH_USER@$HOST:$SSH_PORT"
    else
      fail "SSH connection failed: $SSH_USER@$HOST:$SSH_PORT"
    fi
  fi

  [ "$FAILURES" -eq 0 ]
}

run_connect() {
  validate_config
  [ "$FAILURES" -eq 0 ] || exit 1

  build_ssh_args
  old_ifs=$IFS
  IFS=,
  for port in $PORTS; do
    port=$(devbox_trim "$port")
    SSH_ARGS+=( -L "127.0.0.1:$port:127.0.0.1:$port" )
  done
  IFS=$old_ifs

  printf 'Opening forwards for ports %s. Press Ctrl-C to disconnect.\n' "$PORTS"
  exec ssh "${SSH_ARGS[@]}" -o ExitOnForwardFailure=yes -N "$SSH_USER@$HOST"
}

run_ssh_config() {
  validate_config
  [ "$FAILURES" -eq 0 ] || exit 1

  printf 'Host %s\n' "$NAME"
  printf '    HostName %s\n' "$HOST"
  printf '    User %s\n' "$SSH_USER"
  printf '    Port %s\n' "$SSH_PORT"
  printf '    IdentityFile "%s"\n' "$IDENTITY_FILE"
  printf '    IdentitiesOnly yes\n'
  printf '    ServerAliveInterval 30\n'
  printf '    ServerAliveCountMax 3\n'
  printf '    ExitOnForwardFailure yes\n'
  old_ifs=$IFS
  IFS=,
  for port in $PORTS; do
    port=$(devbox_trim "$port")
    printf '    LocalForward 127.0.0.1:%s 127.0.0.1:%s\n' "$port" "$port"
  done
  IFS=$old_ifs
}

run_status() {
  validate_config
  [ "$FAILURES" -eq 0 ] || exit 1
  build_ssh_args
  ssh "${SSH_ARGS[@]}" "$SSH_USER@$HOST" '
    printf "HOST\n"; hostname; uptime
    printf "\nMEMORY\n"; free -h
    printf "\nDISK\n"; df -h /
    printf "\nDOCKER\n"
    if command -v docker >/dev/null 2>&1; then
      docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Image}}"
      docker system df
    else
      echo "docker is not available"
    fi
  '
}

run_urls() {
  validate_config
  [ "$FAILURES" -eq 0 ] || exit 1
  old_ifs=$IFS
  IFS=,
  for port in $PORTS; do
    port=$(devbox_trim "$port")
    printf 'http://localhost:%s\n' "$port"
  done
  IFS=$old_ifs
}

case "$COMMAND" in
  doctor) run_doctor ;;
  connect) run_connect ;;
  ssh-config) run_ssh_config ;;
  status) run_status ;;
  urls) run_urls ;;
esac
