#!/usr/bin/env bash
set -eu

SCRIPT_PATH=$0
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR=$(CDPATH='' cd -P -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
  LINK_TARGET=$(readlink "$SCRIPT_PATH")
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH=$LINK_TARGET ;;
    *) SCRIPT_PATH="$SCRIPT_DIR/$LINK_TARGET" ;;
  esac
done
ROOT_DIR=$(CDPATH='' cd -P -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd)

printf '%s\n' '[warn] devbox was renamed to otherhost; the compatibility alias will be removed in a future major version' >&2
exec "$ROOT_DIR/bin/otherhost" "$@"
